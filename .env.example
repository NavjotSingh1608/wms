# Copy to .env.local and adjust. Used by docker-compose and local runs.

# Database (override in docker-compose for container hostnames)
DATABASE_URL=postgresql+asyncpg://wms:wms@localhost:5432/wms_dev
SYNC_DATABASE_URL=postgresql://wms:wms@localhost:5432/wms_dev

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# JWT — generate a random 256-bit secret for staging/prod
JWT_SECRET_KEY=change-me-to-a-random-256-bit-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
ENVIRONMENT=development
APP_PORT=8000

# AWS (optional for local — labels/email can be mocked or skipped)
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=wms-labels-dev
# AWS_SES_FROM_EMAIL=noreply@yourdomain.com
