{
  "expo": {
    "name": "WMS",
    "slug": "wms-mobile",
    "version": "1.0.0",
    "extra": {
      "apiUrl": "http://172.20.10.2:8000/api/v1"
    },
    "orientation": "portrait",
    "scheme": "wms",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1e40af"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wms.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "WMS needs camera access to scan QR codes on material labels."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e40af"
      },
      "package": "com.wms.mobile",
      "permissions": ["CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "WMS needs camera access to scan QR codes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1e40af"
        }
      ]
    ]
  }
}
